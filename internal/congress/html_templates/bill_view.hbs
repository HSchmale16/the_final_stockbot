{{!-- Structured Data for SEO: Legislation --}}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Legislation",
  "name": "{{ Title }}",
  "legislationIdentifier": "{{ Bill.BillType }}{{ Bill.BillNumber }}",
  "legislationType": "Bill",
  "legislationDate": "{{ BillBlob.bill.introducedDate }}",
  "legislationJurisdiction": "United States",
  "url": "https://www.dirtycongress.com/bill/{{ Bill.CongressNumber }}/{{ Bill.BillType }}/{{ Bill.BillNumber }}"
}
</script>

{{!-- Breadcrumbs --}}
<nav class="flex text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
    <ol class="flex list-none p-0">
        <li class="flex items-center">
            <a href="/" class="hover:text-blue-600">Home</a>
            <svg class="w-3 h-3 mx-2 fill-current" viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
        </li>
        <li class="flex items-center">
            <a href="/bills" class="hover:text-blue-600">Bills</a>
            <svg class="w-3 h-3 mx-2 fill-current" viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
        </li>
        <li class="font-bold text-gray-900 truncate" aria-current="page">{{ Title }}</li>
    </ol>
</nav>

{{> 'partials/title_heading' title=Title }}

{{#with BillBlob.bill }}
<div class="prose max-w-none mb-8">
    <h3>Bill Summary</h3>
    <table class="w-full text-left">
        <tbody class="divide-y">
            <tr>
                <th class="py-2 pr-4">Introduced Date</th>
                <td class="py-2">{{ formatDate introducedDate }}</td>
            </tr>
            <tr>
                <th class="py-2 pr-4">Last Action</th>
                <td class="py-2">{{ formatDate latestAction.actionDate }} ({{ latestAction.text }})</td>
            </tr>
            <tr>
                <th class="py-2 pr-4">Policy Area</th>
                <td class="py-2">{{ policyArea.name }}</td>
            </tr>
            <tr>
                <th class="py-2 pr-4">Sponsor</th>
                <td class="py-2">
                    {{#each sponsors}}
                        <a href="/congress-member/{{ bioguideId }}">{{ fullName }}</a> ({{ party }}-{{ state }})
                    {{/each}}
                </td>
            </tr>
        </tbody>
    </table>
</div>
{{/with}}




