<div class="space-y-8">
  <!-- Leaders Leaderboard Cards -->
  <div class="grid grid-cols-1 gap-8">
    <!-- Top 5 Longest Missed Vote Streaks (Current Year) -->
    <div class="rounded-2xl bg-white dark:bg-gray-800 p-6 shadow-sm border border-gray-200 dark:border-gray-700">
      <div class="flex items-center space-x-2 pb-4 border-b border-gray-200 dark:border-gray-700">
        <span class="text-xl">⚠️</span>
        <h2 class="text-lg font-bold text-gray-900 dark:text-white">Longest Missed Vote Streaks (Top 5)</h2>
      </div>
      <ul class="divide-y divide-gray-100 dark:divide-gray-700 mt-4">
        {{#each WorstStreaks}}
          <li class="py-3 flex items-center justify-between">
            <div class="flex items-center space-x-3">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-red-50 dark:bg-red-950 flex items-center justify-center text-xs font-semibold text-red-700 dark:text-red-300">
                {{addOne @index}}
              </span>
              <div>
                {{> 'partials/member_pill' Member=this }}
                <p class="text-xs text-gray-400 mt-1 pl-1">
                  <span class="font-medium text-gray-500 dark:text-gray-400">{{this.Chamber}}</span> &middot; {{this.YearsServed}} yrs served &middot; {{this.Age}} yrs old
                </p>
              </div>
            </div>
            <div class="text-right">
              <span class="inline-flex items-center rounded-full bg-red-50 dark:bg-red-900/30 px-2.5 py-0.5 text-xs font-bold text-red-700 dark:text-red-300">
                {{this.MaxMissedStreak}} missed
              </span>
              <p class="text-[10px] text-gray-400 mt-0.5">Overall rate: {{this.AttendanceRate}}%</p>
            </div>
          </li>
        {{else}}
          <li class="py-6 text-center text-sm text-gray-500">No members match the selected filters.</li>
        {{/each}}
      </ul>
    </div>
  </div>

  {{#if IsCurrentYear}}
  <!-- Recently Missing Votes (Current Year Only, Top 20) -->
  <div class="rounded-2xl bg-white dark:bg-gray-800 p-6 shadow-sm border border-gray-200 dark:border-gray-700">
    <div class="flex items-center justify-between pb-4 border-b border-gray-200 dark:border-gray-700">
      <div class="flex items-center space-x-2">
        <span class="text-xl">🚨</span>
        <div>
          <h2 class="text-lg font-bold text-gray-900 dark:text-white">Recently Missing Votes (Top 20)</h2>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Members with the most missed roll call votes across their last 50 eligible votes in {{SelectedYear}}.</p>
        </div>
      </div>
    </div>
    <ul class="divide-y divide-gray-100 dark:divide-gray-700 mt-4">
      {{#each RecentMissers}}
        <li class="py-3.5 flex items-center justify-between hover:bg-gray-50/60 dark:hover:bg-gray-750/30 px-2 rounded-xl transition-colors">
          <div class="flex items-center space-x-3">
            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-amber-50 dark:bg-amber-950 flex items-center justify-center text-xs font-semibold text-amber-700 dark:text-amber-300">
              {{addOne @index}}
            </span>
            <div>
              {{> 'partials/member_pill' Member=this }}
              <p class="text-xs text-gray-400 mt-1 pl-1">
                <span class="font-medium text-gray-500 dark:text-gray-400">{{this.Chamber}}</span> &middot; {{this.YearsServed}} yrs served &middot; {{this.Age}} yrs old
              </p>
            </div>
          </div>
          <div class="text-right">
            <span class="inline-flex items-center rounded-full bg-red-100 dark:bg-red-900/40 px-2.5 py-1 text-xs font-bold text-red-700 dark:text-red-300">
              {{this.RecentMissedVotes}} of last {{this.RecentEligibleVotes}} missed
            </span>
            <p class="text-[10px] text-gray-400 mt-1">Year-to-date attendance: {{this.AttendanceRate}}%</p>
          </div>
        </li>
      {{else}}
        <li class="py-8 text-center text-sm text-gray-500 dark:text-gray-400">
          🎉 No members matching the filters have missed votes recently!
        </li>
      {{/each}}
    </ul>
  </div>
  {{/if}}

  <!-- Full Attendance Dashboard for Year -->
  <div class="rounded-2xl bg-white dark:bg-gray-800 p-6 shadow-sm border border-gray-200 dark:border-gray-700">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-gray-200 dark:border-gray-700 gap-4">
      <div class="flex items-center space-x-2">
        <span class="text-xl">📊</span>
        <div>
          <h2 class="text-lg font-bold text-gray-900 dark:text-white">Worst Congressional Attendance ({{SelectedYear}})</h2>
          <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Voting record and attendance statistics for all active members in {{SelectedYear}}.</p>
        </div>
      </div>
      <!-- Client-side Search Filter -->
      <div class="relative w-full sm:w-64">
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="h-4 w-4 text-gray-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <input
          type="text"
          id="attendance-table-search"
          placeholder="Search name or state..."
          oninput="filterAttendanceTable(this.value)"
          class="block w-full pl-9 pr-3 py-1.5 border border-gray-300 dark:border-gray-600 rounded-lg text-sm bg-white dark:bg-gray-700 text-gray-900 dark:text-white placeholder-gray-400 dark:placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 transition-colors"
        />
      </div>
    </div>
    
    <div class="overflow-x-auto mt-4">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-750">
          <tr>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Rank</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Member</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Chamber</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Party</th>
            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">State</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Total Eligible Votes</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Missed Votes</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Max Missed Streak</th>
            <th scope="col" class="px-4 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Attendance Rate</th>
          </tr>
        </thead>
        <tbody id="attendance-table-body" class="divide-y divide-gray-100 dark:divide-gray-700 bg-white dark:bg-gray-800">
          {{#each AllScores}}
            <tr class="attendance-table-row hover:bg-gray-50/60 dark:hover:bg-gray-750/30 transition-colors" data-name="{{this.Name}}" data-state="{{this.State}}">
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-500 dark:text-gray-400 font-medium">
                {{addOne @index}}
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm">
                {{> 'partials/member_pill' Member=this }}
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600 dark:text-gray-300">
                {{this.Chamber}}
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600 dark:text-gray-300">
                {{this.Party}}
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-gray-600 dark:text-gray-300 font-mono">
                {{this.State}}
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-right text-gray-600 dark:text-gray-300">
                {{this.TotalVotes}}
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-right text-red-600 dark:text-red-400 font-medium">
                {{this.MissedVotes}}
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-right text-amber-600 dark:text-amber-400 font-medium">
                {{this.MaxMissedStreak}}
              </td>
              <td class="px-4 py-3 whitespace-nowrap text-sm text-right">
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-indigo-50 dark:bg-indigo-900/30 text-indigo-700 dark:text-indigo-300">
                  {{this.AttendanceRate}}%
                </span>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="9" class="px-4 py-8 text-center text-sm text-gray-500 dark:text-gray-400">
                No attendance records found matching the selected filters.
              </td>
            </tr>
          {{/each}}
          <tr id="attendance-no-results-row" class="hidden">
            <td colspan="9" class="px-4 py-8 text-center text-sm text-gray-500 dark:text-gray-400">
              No members match your search.
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <script>
      function filterAttendanceTable(query) {
        const term = (query || '').trim().toLowerCase();
        const rows = document.querySelectorAll('#attendance-table-body .attendance-table-row');
        let visibleCount = 0;
        rows.forEach(row => {
          const name = (row.getAttribute('data-name') || '').toLowerCase();
          const state = (row.getAttribute('data-state') || '').toLowerCase();
          if (!term || name.includes(term) || state.includes(term)) {
            row.classList.remove('hidden');
            visibleCount++;
          } else {
            row.classList.add('hidden');
          }
        });
        const noResults = document.getElementById('attendance-no-results-row');
        if (noResults) {
          if (rows.length > 0 && visibleCount === 0) {
            noResults.classList.remove('hidden');
          } else {
            noResults.classList.add('hidden');
          }
        }
      }
    </script>

    {{#if HasFilters}}
    <div class="mt-4 pt-3 border-t border-gray-100 dark:border-gray-700 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-gray-500 dark:text-gray-400">
      <span>Showing {{FilteredCount}} of {{TotalCount}} members</span>
      <span class="inline-flex items-center text-amber-600 dark:text-amber-400 font-medium">
        ℹ️ Table is shorter due to applied filters
      </span>
    </div>
    {{/if}}
  </div>
</div>
