<div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6 my-6 border border-gray-200 dark:border-gray-700 not-prose">
    <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4 flex items-center">
        <svg class="w-6 h-6 mr-2 text-blue-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        Voting Attendance & Record
    </h3>

    {{#if TotalVotes}}
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <!-- Attendance Rate Card -->
        <div class="bg-gray-50 dark:bg-gray-700/50 p-4 rounded-lg text-center flex flex-col justify-center">
            <span class="text-sm font-medium text-gray-500 dark:text-gray-400 block uppercase">Attendance Rate</span>
            <span class="text-3xl font-extrabold text-blue-600 dark:text-blue-400 block mt-1">{{ AttendanceRate }}%</span>
            <span class="text-xs text-gray-500 dark:text-gray-400 mt-2 block">{{ AttendedVotes }} / {{ TotalVotes }} Votes</span>
        </div>

        <!-- Streak Card -->
        <div class="bg-gray-50 dark:bg-gray-700/50 p-4 rounded-lg text-center flex flex-col justify-center">
            <span class="text-sm font-medium text-gray-500 dark:text-gray-400 block uppercase">Current Streak</span>
            <span class="text-3xl font-extrabold text-orange-500 block mt-1">🔥 {{ CurrentStreak }}</span>
            <span class="text-xs text-gray-500 dark:text-gray-400 mt-2 block">Consecutive Votes Attended</span>
        </div>

        <!-- Longest Missed Streak Card -->
        <div class="bg-gray-50 dark:bg-gray-700/50 p-4 rounded-lg text-center flex flex-col justify-center">
            <span class="text-sm font-medium text-gray-500 dark:text-gray-400 block uppercase">Longest Missed Streak</span>
            <span class="text-3xl font-extrabold text-red-500 dark:text-red-400 block mt-1">{{ LongestMissedStreak }}</span>
            <span class="text-xs text-gray-500 dark:text-gray-400 mt-2 block">Consecutive Votes Missed</span>
        </div>

        <!-- Breakdown Card -->
        <div class="bg-gray-50 dark:bg-gray-700/50 p-4 rounded-lg flex flex-col justify-center">
            <span class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-2 text-center">Vote Breakdown</span>
            <div class="flex justify-around text-sm">
                <div class="text-center">
                    <span class="font-bold text-green-600 dark:text-green-400 block">{{ YeaCount }}</span>
                    <span class="text-xs text-gray-500">Yea/Aye</span>
                </div>
                <div class="text-center">
                    <span class="font-bold text-red-600 dark:text-red-400 block">{{ NayCount }}</span>
                    <span class="text-xs text-gray-500">Nay/No</span>
                </div>
                <div class="text-center">
                    <span class="font-bold text-yellow-600 dark:text-yellow-400 block">{{ PresentCount }}</span>
                    <span class="text-xs text-gray-500">Present</span>
                </div>
                <div class="text-center">
                    <span class="font-bold text-gray-600 dark:text-gray-400 block">{{ MissedVotes }}</span>
                    <span class="text-xs text-gray-500">Missed</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Visual Timeline -->
    <div class="mb-6">
        <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2 uppercase tracking-wider">Visual Streak Timeline — Oldest <span class="text-gray-400">→</span> Most Recent (Last 20 Votes)</h4>
        <div class="flex flex-wrap gap-2 items-center bg-gray-50 dark:bg-gray-700/30 p-4 rounded-lg">
            {{#each Timeline}}
            <div class="relative group">
                <div class="w-8 h-8 rounded-md {{ ColorClass }} flex items-center justify-center text-white text-xs font-bold cursor-pointer transition-transform hover:scale-110" title="{{ DateStr }}: {{ VoteStatus }}">
                    {{#if Voted}}✓{{else}}✗{{/if}}
                </div>
                <!-- Tooltip -->
                <div class="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 w-48 bg-gray-900 text-white text-xs rounded py-1 px-2 opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none z-10 text-center shadow-lg">
                    <p class="font-bold">{{ Chamber }} Roll #{{ RollCall }}</p>
                    <p class="text-[10px] text-gray-400 mt-0.5">{{ DateStr }}</p>
                    <p class="mt-0.5 truncate">{{ VoteDesc }}</p>
                    <p class="mt-0.5 text-gray-400">Voted: <span class="{{#if Voted}}text-gray-300{{else}}text-red-400{{/if}}">{{ VoteStatus }}</span></p>
                </div>
            </div>
            {{/each}}
        </div>
    </div>

    <!-- Recent Votes Table -->
    <div>
        <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2 uppercase tracking-wider">Recent Votes Cast</h4>
        <div class="overflow-x-auto border border-gray-200 dark:border-gray-700 rounded-lg">
            <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
                <thead class="bg-gray-50 dark:bg-gray-700">
                    <tr>
                        <th scope="col" class="px-4 py-2 text-left font-medium text-gray-500 dark:text-gray-400">Date</th>
                        <th scope="col" class="px-4 py-2 text-left font-medium text-gray-500 dark:text-gray-400">Chamber</th>
                        <th scope="col" class="px-4 py-2 text-left font-medium text-gray-500 dark:text-gray-400">Roll #</th>
                        <th scope="col" class="px-4 py-2 text-left font-medium text-gray-500 dark:text-gray-400">Legislation</th>
                        <th scope="col" class="px-4 py-2 text-left font-medium text-gray-500 dark:text-gray-400">Description / Amendment</th>
                        <th scope="col" class="px-4 py-2 text-left font-medium text-gray-500 dark:text-gray-400">Vote Cast</th>
                        <th scope="col" class="px-4 py-2 text-left font-medium text-gray-500 dark:text-gray-400">Result</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-800">
                    {{#each RecentVotes}}
                    <tr class="hover:bg-gray-50 dark:hover:bg-gray-700/50">
                        <td class="px-4 py-2 whitespace-nowrap text-gray-600 dark:text-gray-300">{{ DateStr }}</td>
                        <td class="px-4 py-2 whitespace-nowrap text-gray-600 dark:text-gray-300">{{ Chamber }}</td>
                        <td class="px-4 py-2 whitespace-nowrap text-gray-600 dark:text-gray-300">{{ RollCall }}</td>
                        <td class="px-4 py-2 whitespace-nowrap font-semibold text-gray-900 dark:text-white">{{ LegisName }}</td>
                        <td class="px-4 py-2 text-gray-900 dark:text-white max-w-xs truncate" title="{{ Question }}">
                            {{ Question }}
                            {{#if AmendmentInfo}}
                            <span class="block text-xs text-orange-500 font-medium mt-0.5">{{ AmendmentInfo }}</span>
                            {{/if}}
                        </td>
                        <td class="px-4 py-2 whitespace-nowrap font-semibold">
                            <span class="{{#if (eq VoteCast 'Not Voting')}}text-red-500{{else}}{{#if (eq VoteCast 'Absent')}}text-red-500{{else}}text-green-600 dark:text-green-400{{/if}}{{/if}}">
                                {{ VoteCast }}
                            </span>
                        </td>
                        <td class="px-4 py-2 whitespace-nowrap text-gray-600 dark:text-gray-300">{{ Result }}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    </div>
    {{else}}
    <p class="text-gray-500 dark:text-gray-400 text-center py-4">No voting records found for this member in the database.</p>
    {{/if}}
</div>