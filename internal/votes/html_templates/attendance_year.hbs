<div class="space-y-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
  <!-- Breadcrumbs -->
  <nav class="flex text-sm text-gray-500 mb-4" aria-label="Breadcrumb">
    <ol class="flex list-none p-0 space-x-2">
      <li class="flex items-center">
        <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
        <svg class="w-3 h-3 mx-2 fill-current" viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
      </li>
      <li class="font-bold text-gray-900 dark:text-white truncate" aria-current="page">Attendance Scoreboard</li>
    </ol>
  </nav>

  <!-- Header & Description -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between border-b border-gray-200 dark:border-gray-800 pb-6">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
        Congressional Attendance Scoreboard <span class="text-indigo-600 dark:text-indigo-400">({{SelectedYear}})</span>
      </h1>
      <p class="mt-2 text-sm text-gray-500 dark:text-gray-400 max-w-3xl">
        A non-partisan view of voting attendance, participation rates, and consecutive missed vote streaks across the U.S. Congress.
        You elect them to represent you, and they're very well paid. They should be there to represent you the people, but sometimes they just aren't.
      </p>
      <p>Wouldn't it be nice if we the people had the same sick time off?</p>
    </div>
    <div class="mt-4 md:mt-0">
      <form method="GET" class="flex items-center space-x-2 bg-white dark:bg-gray-800 p-2 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700">
        <label for="year" class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Select Year</label>
        <select
          id="year-selector"
          name="year"
          onchange="location.href='/attendance/' + this.value + window.location.search"
          class="rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 pl-3 pr-10 py-1.5 text-sm font-medium text-gray-700 dark:text-white shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-1 focus:ring-indigo-500"
        >
          {{#each AvailableYears}}
            <option value="{{this}}" {{eqTernaryShort this SelectedYear "selected" ""}}>{{this}}</option>
          {{/each}}
        </select>
      </form>
    </div>
  </div>

  <!-- Annual Voting Frequency Sparkline Strip (HTMX Lazy Loaded) -->
  <div 
    id="sparkline-container"
    hx-get="/htmx/attendance/{{SelectedYear}}/sparkline?chamber={{ActiveChamber}}"
    hx-trigger="load"
    hx-swap="innerHTML"
  >
    <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-200 dark:border-gray-700 animate-pulse">
      <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-1/4 mb-4"></div>
      <div class="h-16 bg-gray-100 dark:bg-gray-750 rounded"></div>
    </div>
  </div>

  <!-- Methodology Intro Block -->
  <div class="bg-indigo-50 dark:bg-indigo-950/40 rounded-2xl p-6 border border-indigo-100 dark:border-indigo-900/60 shadow-sm">
    <h3 class="text-lg font-bold text-indigo-900 dark:text-indigo-200">About this Scoreboard</h3>
    <p class="mt-2 text-sm text-indigo-700 dark:text-indigo-300 leading-relaxed">
      This board calculates voting attendance using data pulled from <a href="https://voteview.com">VoteView by UCLA</a>. 
      To ensure fairness, a member's attendance rate is evaluated <strong>only for votes cast after they took office</strong>.
      Streaks and metrics require a minimum of 15 eligible votes in the selected year to qualify.
    </p>
  </div>

  <!-- High-level Callout Cards (HTMX Lazy Loaded) -->
  <div 
    id="attendance-stats-container"
    hx-get="/htmx/attendance/{{SelectedYear}}/stats"
    hx-trigger="load"
    hx-swap="innerHTML"
  >
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      {{#if IsCurrentYear}}
      <div class="rounded-2xl bg-white dark:bg-gray-800 p-6 shadow-sm border border-gray-200 dark:border-gray-700 animate-pulse space-y-4">
        <div class="h-3 bg-gray-200 dark:bg-gray-700 rounded w-1/3"></div>
        <div class="h-8 bg-gray-200 dark:bg-gray-700 rounded w-1/2"></div>
        <div class="h-6 bg-gray-100 dark:bg-gray-750 rounded"></div>
      </div>
      {{/if}}
      <div class="rounded-2xl bg-white dark:bg-gray-800 p-6 shadow-sm border border-gray-200 dark:border-gray-700 animate-pulse space-y-4 {{#unless IsCurrentYear}}sm:col-span-2{{/unless}}">
        <div class="h-3 bg-gray-200 dark:bg-gray-700 rounded w-1/3"></div>
        <div class="h-8 bg-gray-200 dark:bg-gray-700 rounded w-1/2"></div>
        <div class="h-4 bg-gray-100 dark:bg-gray-750 rounded w-2/3"></div>
      </div>
    </div>
  </div>

  <!-- Interactive Filters -->
  <form 
    id="attendance-filters"
    hx-get="/htmx/attendance/{{SelectedYear}}"
    hx-target="#scoreboard-container"
    hx-swap="innerHTML"
    hx-trigger="change"
    class="bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-sm border border-gray-200 dark:border-gray-700 space-y-6"
  >
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Chamber Filter -->
      <div class="space-y-2">
        <span class="text-xs font-bold text-gray-400 uppercase tracking-wider block">Chamber</span>
        <div class="flex space-x-2">
          {{#each Chambers}}
            <label class="flex-1 cursor-pointer">
              <input 
                type="radio" 
                name="chamber" 
                value="{{this.Value}}" 
                {{#eq this.Value ../ActiveChamber}}checked{{/eq}}
                class="sr-only peer"
              />
              <div class="text-center py-2 px-3 text-sm font-semibold rounded-xl border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 peer-checked:bg-indigo-600 peer-checked:text-white peer-checked:border-indigo-600 transition-all">
                {{this.Label}}
              </div>
            </label>
          {{/each}}
        </div>
      </div>

      <!-- Tenure Filter -->
      <div class="space-y-2">
        <span class="text-xs font-bold text-gray-400 uppercase tracking-wider block">Tenure</span>
        <div class="flex space-x-2">
          {{#each Tenures}}
            <label class="flex-grow cursor-pointer">
              <input 
                type="radio" 
                name="tenure" 
                value="{{this.Value}}" 
                {{#eq this.Value ../ActiveTenure}}checked{{/eq}}
                class="sr-only peer"
              />
              <div class="text-center py-2 px-2 text-xs font-semibold rounded-xl border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 peer-checked:bg-indigo-600 peer-checked:text-white peer-checked:border-indigo-600 transition-all">
                {{this.Label}}
              </div>
            </label>
          {{/each}}
        </div>
      </div>

      <!-- Age Filter -->
      <div class="space-y-2">
        <span class="text-xs font-bold text-gray-400 uppercase tracking-wider block">Age</span>
        <div class="flex space-x-2">
          {{#each Ages}}
            <label class="flex-grow cursor-pointer">
              <input 
                type="radio" 
                name="age" 
                value="{{this.Value}}" 
                {{#eq this.Value ../ActiveAge}}checked{{/eq}}
                class="sr-only peer"
              />
              <div class="text-center py-2 px-2 text-xs font-semibold rounded-xl border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 bg-white dark:bg-gray-800 hover:bg-gray-50 dark:hover:bg-gray-700 peer-checked:bg-indigo-600 peer-checked:text-white peer-checked:border-indigo-600 transition-all">
                {{this.Label}}
              </div>
            </label>
          {{/each}}
        </div>
      </div>
    </div>
  </form>

  <!-- Scoreboard Target Container (HTMX Lazy Loaded on page load) -->
  <div 
    id="scoreboard-container" 
    class="transition-opacity duration-200"
    hx-get="/htmx/attendance/{{SelectedYear}}?chamber={{ActiveChamber}}&tenure={{ActiveTenure}}&age={{ActiveAge}}"
    hx-trigger="load"
    hx-swap="innerHTML"
  >
    <div class="space-y-8 animate-pulse">
      <div class="rounded-2xl bg-white dark:bg-gray-800 p-6 shadow-sm border border-gray-200 dark:border-gray-700 space-y-4">
        <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-1/4"></div>
        <div class="h-10 bg-gray-100 dark:bg-gray-750 rounded"></div>
        <div class="h-10 bg-gray-100 dark:bg-gray-750 rounded"></div>
      </div>
      <div class="rounded-2xl bg-white dark:bg-gray-800 p-6 shadow-sm border border-gray-200 dark:border-gray-700 space-y-4">
        <div class="h-4 bg-gray-200 dark:bg-gray-700 rounded w-1/3"></div>
        <div class="h-12 bg-gray-100 dark:bg-gray-750 rounded"></div>
        <div class="h-12 bg-gray-100 dark:bg-gray-750 rounded"></div>
        <div class="h-12 bg-gray-100 dark:bg-gray-750 rounded"></div>
      </div>
    </div>
  </div>
</div>
