<div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
  {{#if IsCurrentYear}}
  <!-- Longest Missed Streak Card (Current Year) -->
  <div class="overflow-hidden rounded-2xl bg-white dark:bg-gray-800 p-6 shadow-sm border border-gray-200 dark:border-gray-700 flex flex-col justify-between">
    <div>
      <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Longest Missed Streak</span>
      <div class="mt-2 flex items-baseline text-3xl font-extrabold text-red-600 dark:text-red-400">
        {{#if WorstLeader.MaxMissedStreak}}{{WorstLeader.MaxMissedStreak}} votes{{else}}N/A{{/if}}
      </div>
    </div>
    <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700">
      {{#if WorstLeader}}
        {{> 'partials/member_pill' Member=WorstLeader }}
      {{else}}
        <span class="text-xs text-gray-400">No data available</span>
      {{/if}}
    </div>
  </div>
  {{/if}}

  <!-- Active Average Attendance -->
  <div class="overflow-hidden rounded-2xl bg-white dark:bg-gray-800 p-6 shadow-sm border border-gray-200 dark:border-gray-700 flex flex-col justify-between {{#unless IsCurrentYear}}sm:col-span-2{{/unless}}">
    <div>
      <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Overall Avg Attendance</span>
      <div class="mt-2 flex items-baseline text-3xl font-extrabold text-indigo-600 dark:text-indigo-400">
        {{OverallAvg}}%
      </div>
    </div>
    <div class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700 flex items-center justify-between text-xs text-gray-500 dark:text-gray-400 font-semibold">
      <span>Senate: {{SenateAvg}}%</span>
      <span>House: {{HouseAvg}}%</span>
    </div>
  </div>
</div>
