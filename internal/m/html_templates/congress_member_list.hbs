{{!-- Breadcrumbs --}}
<nav class="flex text-sm text-gray-500 mb-6" aria-label="Breadcrumb">
    <ol class="flex list-none p-0">
        <li class="flex items-center">
            <a href="/" class="hover:text-blue-600">Home</a>
            <svg class="w-3 h-3 mx-2 fill-current" viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
        </li>
        <li class="font-bold text-gray-900 truncate" aria-current="page">{{ Title }}</li>
    </ol>
</nav>

{{> 'partials/title_heading' title="Current Members of Congress" subtitle="The 117th Congress" }}

<p>Here you can see the current members of congress. This table is sortable by how long they have been in office, and by how many gifted trips they have received recently.</p>

<table class="min-w-full table-auto divide-y divide-gray-200 shadow-md source">
    <thead class="bg-gray-50">
        <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">State</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider" dataType="date">First Took Office</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider" dataType="number">Travel Count (Past 2 years)</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider" dataType="number">Committee Count</th>
        </tr>
    </thead>
    <tbody class="bg-white divide-y divide-gray-200">
        {{#each ActiveMembers}}
        <tr class="odd:bg-white even:bg-gray-50">
            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                {{> 'partials/member_pill' Member=this }}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ this.State }}
                {{#unless this.IsSenator }}
                {{ this.District }}
                {{/unless}}
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900" sorttable_customkey="{{ this.TookOfficeOn }}">{{ formatDate this.TookOfficeOn }} ({{ this.YearsServedDisplay }})</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ this.TravelCount }}</td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">{{ this.CommitteeCount }}</td>
        </tr>
        {{/each}}
    </tbody>
</table>
</div>

<div class="target"></div>

{{> 'scripts/sorttable' search=true }}
