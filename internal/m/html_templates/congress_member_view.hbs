<div class="prose-xl">
    {{!-- Structured Data for SEO: Person --}}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "{{ Member.Name }}",
      "jobTitle": "{{#if Member.IsSenator}}Senator{{else}}Representative{{/if}}",
      "birthDate": "{{ Member.CongressMemberInfo.Bio.Birthday }}",
      "memberOf": [
        {
          "@type": "Organization",
          "name": "United States Congress"
        },
        {
          "@type": "Organization",
          "name": "{{ Member.Party }} Party"
        }
      ],
      "url": "https://www.dirtycongress.com/congress-member/{{ Member.BioGuideId }}",
      "sameAs": [
        "https://en.wikipedia.org/wiki/{{ Member.CongressMemberInfo.Id.Wikipedia }}",
        "https://ballotpedia.org/{{ Member.CongressMemberInfo.Id.Ballotpedia }}"
      ]
    }
    </script>

    {{!-- Breadcrumbs --}}
    <nav class="flex text-sm text-gray-500 mb-6 not-prose" aria-label="Breadcrumb">
        <ol class="flex list-none p-0">
            <li class="flex items-center">
                <a href="/" class="hover:text-blue-600">Home</a>
                <svg class="w-3 h-3 mx-2 fill-current" viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
            </li>
            <li class="flex items-center">
                <a href="/congress-members" class="hover:text-blue-600">Congress Members</a>
                <svg class="w-3 h-3 mx-2 fill-current" viewBox="0 0 24 24"><path d="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"/></svg>
            </li>
            <li class="font-bold text-gray-900 truncate" aria-current="page">{{ Member.Name }}</li>
        </ol>
    </nav>

    <h1>{{ Member.Name }}</h1>

    {{> 'partials/share_buttons' }}

    <div class="grid grid-cols-2">
        <div class="">
            <h3>Bio Information</h3>
            Born: {{#if Member.CongressMemberInfo.Bio.Birthday}}
            {{ formatDate Member.CongressMemberInfo.Bio.Birthday }}
            {{else}}
            Not Available
            {{/if}}
        </div>
        <div class="">
            <h3>Terms</h3>
            <ul>
                {{#each Terms }}
                <li>{{ formatDate Start }} to {{ formatDate End }} for {{ State }} as
                    {{#if IsSenator }}
                    Senator
                    {{else}}
                    Representative
                    {{/if}}
                    - {{ Party }}
                </li>
                {{/each}}
            </ul>
        </div>
    </div>

    <div hx-get="/htmx/votes/member/{{ Member.BioGuideId }}" hx-trigger="load" class="row"></div>

    <div class="row" hx-get="/htmx/congress-member/{{ Member.BioGuideId }}/travel" hx-trigger="load"></div>

    {{!-- <div class="row" hx-get="/congress-member/{{ Member.BioGuideId }}/finances" hx-trigger="load"></div> --}}

    <div class="row">
        <h2>Committees</h2>
        {{#if Member.Committees }}
        <ul>
            {{#each Member.Committees }}
            {{!-- A committee membership object --}}
            <li><a href="/committee/{{ Committee.ThomasId}}">{{ Committee.Name }}</a>

                {{#if Committee.Subcommittees }}
                <ul>
                    {{#each Committee.Subcommittees }}
                    <li><a href="/committee/{{ Committee.ThomasId }}">{{ Name }}</a></li>
                    {{/each}}
                </ul>
                {{/if}}
            </li>
            {{/each}}
        </ul>
        {{else}}
        <p>This Congressperson is not on any committees at the moment.</p>
        {{/if}}
    </div>

    <div class="row" hx-get="/htmx/congress-member/{{ Member.BioGuideId }}/other-from-state" hx-trigger="load"></div>

    <div class="row">
        <h3>External Links</h3>
        <p>Learn more about this Congressperson from External Resources!</p>
        {{#with Member.CongressMemberInfo.Id }}
        <ul>
            <li><a href="https://en.wikipedia.org/wiki/{{ Wikipedia }}">Wikipedia</a></li>
            <li><a href="https://ballotpedia.org/{{ Ballotpedia }}">Balltopedia</a></li>
            {{#each Fec }}
            <li><a href="https://www.fec.gov/data/candidate/{{ this }}">Federal Election Commission</a></li>
            {{/each}}
        </ul>
        {{/with}}
    </div>


</div>