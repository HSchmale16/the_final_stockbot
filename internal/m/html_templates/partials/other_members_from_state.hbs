<div class="row mt-8">
    <h3>Other Members from {{ State }}</h3>
    <div class="flex flex-wrap gap-4">
        {{#each Members }}
        <div class="card w-full sm:w-1/3 md:w-1/4 lg:w-1/5 shadow-sm border rounded-lg overflow-hidden bg-white dark:bg-gray-800">
            <div class="p-4">
                <h5 class="font-bold text-lg mb-1 truncate">
                    <a href="/congress-member/{{ BioGuideId }}" class="text-blue-600 hover:underline">{{ Name }}</a>
                </h5>
                <p class="text-sm text-gray-600 dark:text-gray-400">
                    {{ Party }} - {{#if IsSenator}}Senator{{else}}Representative{{/if}}
                </p>
            </div>
        </div>
        {{/each}}
    </div>
    <div class="mt-4">
        <a href="/congress-members?state={{ State }}" class="text-blue-600 hover:underline font-semibold">
            View all members from {{ State }} &rarr;
        </a>
    </div>
</div>
