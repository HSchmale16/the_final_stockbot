# Cache storage configuration
# Keys zone allows up to ~80k keys in 10MB memory; max_size caps disk usage
proxy_cache_path /var/cache/nginx/stockbot_cache levels=1:2 keys_zone=stockbot_cache:10m max_size=500m inactive=60m use_temp_path=off;

# Default server configuration
server {

    root /var/www/html; # Replace this with the path to your single page app files

    index index.html;

    server_name {{ server_name }};

    # Expose cache HIT/MISS/BYPASS status header
    add_header X-Cache-Status $upstream_cache_status;

    location / {
        proxy_cache stockbot_cache;
        proxy_cache_valid 200 302 5m;
        proxy_cache_valid 404 1m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_cache_lock on;

        # Allow bypassing cache during profiling or when explicitly requested
        proxy_cache_bypass $http_cache_control $http_x_bypass_cache;
        proxy_no_cache $http_cache_control $http_x_bypass_cache;

        proxy_pass http://localhost:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Raise the proxy read time out
        proxy_read_timeout 10s;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    location /static/ {
        alias {{ static_root }};
        autoindex off;
        # gzip on;
        # gzip_types application/javascript text/javascript image/jpeg text/css text/html text/plain text/xml application/json application/xml;
        etag on;
        expires 60d;
        add_header Cache-Control "public";
        try_files $uri $uri/ /index.html;
    }

    location /sitemap.xml {
        alias {{ static_root }}/sitemap.xml;
    }

    location /robots.txt {
        alias {{ static_root }}/robots.txt;
    }

    location /secret-metrics {
            stub_status on;
    }

    # Hidden pprof endpoints — only accessible with a Bearer token.
    # Usage: curl -H "Authorization: Bearer <secret>" https://{{ server_name }}/debug/pprof/
    location /debug/pprof/ {
        if ($http_authorization != "Bearer {{ pprof_secret_key }}") {
            return 403;
        }
        proxy_pass          http://127.0.0.1:6060/debug/pprof/;
        proxy_set_header    Host          localhost;
        proxy_set_header    Authorization "";  # strip before forwarding
        proxy_read_timeout  90s;
    }

    # Hidden Prometheus UI — Basic auth: user from secrets, password = pprof_secret_key.
    # Usage: curl -u "{{ prometheus_user }}:<pprof_secret_key>" https://{{ server_name }}/prometheus/
    location /prometheus/ {
        if ($http_authorization != "Basic {{ (prometheus_user + ':' + pprof_secret_key) | b64encode }}") {
            return 403;
        }
        proxy_pass          http://127.0.0.1:9090/;
        proxy_set_header    Host          localhost;
        proxy_set_header    Authorization "";  # strip before forwarding
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/{{ server_name }}/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/{{ server_name }}/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}


server {
    if ($host = {{ server_name }}) {
        return 301 https://{{ server_name }}$request_uri;
    } # managed by Certbot


    server_name {{ server_name }};
    listen 80;
    return 404; # managed by Certbot


}

server {
    listen 80;
    server_name govt.henryschmale.org;
    return 301 https://{{ server_name }}$request_uri;
}